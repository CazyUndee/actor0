# Agent scratch: patch scripts, probe outputs, capture logs. Not part of the
# product, and the one thing in a working tree that a stray `git add -A` would
# happily publish.

# Terminal-Bench harness venv: installed into the repo so a benchmark run
# never touches the global environment. Rebuilt with:
#   uv venv .tbench-venv && uv pip install --python .tbench-venv/Scripts/python.exe terminal-bench
/.tbench-venv/

# Rendered setup-script scratch from adapter verification.
/.tbench-setup-test.sh

# Python bytecode from the Terminal-Bench adapter, imported on the host.
__pycache__/
*.pyc

# Agent scratch: error logs, probe outputs, capture logs, temp scripts,
# benchmark output. Not part of the product; a stray `git add -A` would
# happily publish them.
*.err
.mcp-serve-stderr.txt
*-probe.txt
probe.ts
halo-tui.md
run-tools-test.ps1
benchmark/
scratch/
