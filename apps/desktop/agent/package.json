{
  "name": "@actor0/desktop-agent",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "main": "./dist/agent.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "npm --workspace @actor0/harness run build && npm --workspace @actor0/providers run build && tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@actor0/harness": "*",
    "@actor0/providers": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8.5.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.20",
    "typescript": "^5.9"
  }
}
