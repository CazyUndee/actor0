{
  "name": "@actor0/desktop-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:agent": "node esbuild.config.mjs",
    "preview": "vite preview",
    "neu": "neu",
    "desktop": "npm run build && npm run build:agent && npm run neu run",
    "desktop:win": "npm run build && npm run build:agent && npm run neu build --platform win --arch x64 --resources"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@esbuild-plugins/node-resolve": "^0.2.2",
    "@neutralinojs/neu": "^11.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.4",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "ws": "^8.14.0"
  }
}
