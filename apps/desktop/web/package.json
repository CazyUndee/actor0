{
  "name": "@actor0/desktop-web",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "agent": "npm --workspace @actor0/desktop-agent run build",
    "shell": "npm run build && npm run agent && npm run assemble && neu run",
    "package:win": "npm run build && npm run agent && npm run assemble && neu build --platform win --arch x64",
    "assemble": "node scripts/assemble.mjs"
  },
  "dependencies": {
    "@actor0/harness": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.8.0",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.20",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
