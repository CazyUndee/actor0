{
  "applicationId": "com.actor0.desktop",
  "version": "0.5.7",
  "defaultMode": "chrome",
  "url": "/",
  "documentRoot": "/resources/app",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": true,
  "singlePageServe": true,
  "nativeAllowList": [
    "filesystem.*",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "os.getSpawnedProcesses",
    "os.getEnv",
    "os.open",
    "os.showNotification",
    "events.*",
    "debug.*",
    "window.setTitle",
    "app.exit"
  ],
  "commandAllowList": [
    "node"
  ],
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "actor0",
      "width": 1100,
      "height": 780,
      "minWidth": 520,
      "minHeight": 420,
      "center": true,
      "resizable": true,
      "exitProcessOnClose": true,
      "useSavedState": true,
      "enableInspector": true,
      "injectClientLibrary": true
    },
    "chrome": {
      "args": "",
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  },
  "injectClientLibrary": true
}
