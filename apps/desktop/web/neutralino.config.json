{
  "applicationId": "com.actor0.desktop",
  "version": "0.5.8",
  "defaultMode": "window",
  "url": "/",
  "documentRoot": "/resources/app",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "exportAuthInfo": true,
  "singlePageServe": true,
  "nativeAllowList": [
    "filesystem.*",
    "os.open",
    "os.getPath",
    "os.showFolderDialog",
    "events.*",
    "debug.*",
    "resources.*",
    "window.minimize",
    "window.maximize",
    "window.unmaximize",
    "window.isMaximized",
    "window.close",
    "window.getPosition",
    "window.getSize",
    "window.setSize",
    "window.move",
    "window.beginDrag",
    "window.setIcon",
    "app.exit"
  ],
  "commandAllowList": [],
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "actor0",
      "width": 1100,
      "height": 780,
      "minWidth": 520,
      "minHeight": 420,
      "center": true,
      "resizable": false,
      "exitProcessOnClose": true,
      "useSavedState": true,
      "enableInspector": false,
      "injectClientLibrary": false,
      "borderless": true,
      "sizeConstraint": false,
      "transparent": true
    },
    "chrome": {
      "args": "--user-data-dir=${NL_PATH}/.chrome-profile --class=actor0 --disable-pinch --disable-zoom --app-window-title=actor0",
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "resourcesPath": "resources",
    "binaryName": "actor0-desktop"
  },
  "injectClientLibrary": true
}
