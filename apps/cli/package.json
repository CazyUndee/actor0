{
  "name": "@actor0/cli",
  "version": "0.5.5",
  "type": "module",
  "bin": {
    "actor0": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --tsBuildInfoFile dist/.tsbuildinfo && node scripts/bundle.mjs",
    "prepack": "node -e \"require('fs').rmSync('dist/.tsbuildinfo',{force:true})\"",
    "typecheck": "npm --workspace @actor0/harness run build && npm --workspace @actor0/providers run build && tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "gen:theme": "node scripts/generate-theme.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "preview": "tsx scripts/preview-tui.tsx",
    "check:tui": "tsx scripts/preview-tui.tsx"
  },
  "dependencies": {
    "@actor0/harness": "*",
    "@actor0/providers": "*",
    "cronixui": "^1.1.5",
    "ink": "^6",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsx": "^4.20",
    "typescript": "^5.9"
  }
}
